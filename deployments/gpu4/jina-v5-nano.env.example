COMPOSE_PROJECT_NAME=embedding-provider-jina-v5-nano
SERVICE_NAME=jina-v5-nano
BIND_HOST=100.93.145.69
PORT=7997
API_KEY=change-me
HF_CACHE_DIR=./runtime-cache/jina-v5-nano
# One card, or a list (0,1): each GPU worker start uses the listed card with the most free VRAM.
CUDA_VISIBLE_DEVICES=0
SHM_SIZE=2g
PUBLIC_HOSTNAME=
PUBLIC_BIND=
PUBLIC_UPSTREAM=127.0.0.1:7997

MODEL_ID=jinaai/jina-embeddings-v5-text-nano
MODEL_ALIAS=jinaai/jina-embeddings-v5-text-nano
EMBEDDING_TASK=text-matching
DEFAULT_DIMENSIONS=768
MAX_LENGTH=8192
MAX_BATCH_SIZE=64
BATCH_WINDOW_MS=200
START_DEVICE=cpu
CPU_BATCH_TARGET=8
CPU_TO_GPU_SCALE_UP_TEXTS=8
GPU_TO_CPU_SCALE_DOWN_TEXTS=8
GPU_TO_CPU_SCALE_DOWN_SECONDS=30
IDLE_OFFLOAD_SECONDS=1800
IDLE_OFFLOAD_POLL_SECONDS=30
DEVICE_SWITCH_MIN_SECONDS=30
REQUEST_LOG_LIMIT=100000
EMBEDDING_CACHE_LIMIT=100000
CUDA_BATCH_GROWTH_FACTOR=2
CUDA_BATCH_DEMAND_EMA_ALPHA=0.75
CUDA_VRAM_SAFETY_FIXED_MB=512
CUDA_VRAM_SAFETY_TOTAL_RATIO=0.05
GPU_FORWARD_CONCURRENCY=1
NORMALIZE_EMBEDDINGS=true
DTYPE=bfloat16
ATTN_IMPLEMENTATION=
TRUST_REMOTE_CODE=true
